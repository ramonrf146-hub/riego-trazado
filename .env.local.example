# Copiá este archivo a .env.local para desarrollo local (nunca commitear .env.local).
# En producción (Vercel / GitHub Actions) configurá estas mismas variables
# como "Environment Variables" / "Secrets" del proyecto — nunca hardcodeadas.

# --- Amazon Product Advertising API (PA-API 5.0) ---
# Requeridas para correr scripts/actualizar-productos.mjs sin --mock.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Opcionales — default apunta al marketplace de EE.UU.
# AMAZON_HOST=webservices.amazon.com
# AMAZON_REGION=us-east-1
# AMAZON_MARKETPLACE=www.amazon.com

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://riegocom.uk

# --- Analítica (opcional, GA4) ---
# Dejar vacío para correr sin analítica en desarrollo.
NEXT_PUBLIC_GA_ID=

# --- Solo si usás el endpoint /api/cron/actualizar-productos con Vercel Cron ---
# Secreto compartido para autenticar la llamada del cron (ver README).
CRON_SECRET=
